doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
  body
    //- Vista de acceso
    main#loginView.login-view
      section.login-card
        div.login-brand
          span.brand-mark
            img(src="/images/logo.jpg" alt="Logo de Estudio Pilates")
          span Estudio Pilates
        p.eyebrow.mb-2 Bienvenida
        h1 Tu estudio, en orden.
        p.login-copy Inicia sesión para gestionar a tus clientes, pagos y asistencias.
        form#loginForm
          label.form-label(for="usuario") Correo electrónico
          input.form-control.mb-3#usuario(type="email" placeholder="nombre@ejemplo.com" autocomplete="email" required)
          label.form-label(for="contrasena") Contraseña
          input.form-control.mb-3#contrasena(type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required)
          p#loginError.form-error(hidden) Usuario o contraseña incorrectos.
          button.btn.btn-primary.w-100.py-2(type="submit") Iniciar sesión
          button.btn-link.mx-auto#recuperarContrasena(type="button") ¿Olvidaste tu contraseña?
        p.login-help Usa el correo y contraseña creados por el administrador.

    //- Aplicación autenticada
    div#appView.app-shell(hidden)
      aside.sidebar
        div.sidebar-brand
          span.brand-mark
            img(src="/images/logo.jpg" alt="Logo de Estudio Pilates")
          span Estudio Pilates
        nav.sidebar-nav(aria-label="Navegación principal")
          button.nav-link.active(type="button" data-view="inicio")
            span ◉
            | Inicio
          button.nav-link(type="button" data-view="clientes")
            span ♧
            | Clientes
          button.nav-link(type="button" data-view="pagos")
            span $
            | Pagos
          button.nav-link(type="button" data-view="planes")
            span ◫
            | Planes
          button.nav-link(type="button" data-view="historial")
            span ◷
            | Historial
          button.nav-link(type="button" data-view="agenda")
            span ◫
            | Agenda
          button.nav-link.admin-only(type="button" data-view="ingresos")
            span ◔
            | Finanzas
        div.sidebar-bottom
          span#usuarioActivo
          button#cerrarSesion.btn-link(type="button") Cerrar sesión

      main.app-main
        header.app-header
          div
            p.eyebrow.mb-1 Sistema de gestión
            h1#pageTitle Inicio
          div.header-actions
            button.btn.btn-outline-primary.btn-sm#actualizarDatos(type="button") ↻ Actualizar
            div.date-display#fechaActual

        section#inicio.view-panel
          section.hero
            div
              p.eyebrow.mb-2 Resumen del día
              h2 Todo listo para recibir a tus clientes.
              p.mb-0 Consulta un expediente o registra una asistencia desde aquí.
            img.hero-silhouette(src="/images/logo.jpg" alt="Logo de Estudio Pilates")
          div.dashboard-grid
            article.metric-card
              span.metric-label Asistencias hoy
              strong#asistenciasHoy 0
              small Clientes registrados hoy
            article.metric-card
              span.metric-label Clientes activos
              strong#clientesActivos 0
              small Con paquete vigente
            article.metric-card
              span.metric-label Próximos vencimientos
              strong#proximosVencimientos 0
              small En los siguientes 7 días
          div.content-card.search-card
            label.form-label(for="buscador") Buscar cliente
            div.search-row
              input.form-control#buscador(type="search" placeholder="Escribe nombre, apellido o teléfono")
              button.btn.btn-primary#nuevoClienteInicio(type="button") + Nuevo cliente
            div#resultadosBusqueda.search-results
          div.row.g-4
            div.col-lg-7
              div.content-card.h-100
                h3.h5 Asistencias de la semana
                p.card-description Últimos siete días
                div.chart-wrap#graficaSemana
            div.col-lg-5
              div.content-card.h-100
                h3.h5 Actividad reciente
                ul#actividadReciente.activity-list

        section#clientes.view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Expedientes
              h2 Clientes
            button.btn.btn-primary#nuevoCliente(type="button") + Registrar cliente
          div.content-card.search-card
            label.form-label(for="buscadorClientes") Buscar para asistencia
            input.form-control#buscadorClientes(type="search" inputmode="numeric" maxlength="4" placeholder="Ingresa el código de 4 dígitos del cliente")
          div.content-card.table-card
            div.table-responsive
              table.table.align-middle.mb-0
                thead
                  tr
                    th Código
                    th Cliente
                    th Paquete
                    th Restantes
                    th Vencimiento
                    th Último pago
                    th
                tbody#tablaClientes
          div#sinClientes.empty-state(hidden)
            div.empty-icon ♡
            h3 Aún no hay clientes
            p Registra tu primer cliente para empezar.

        section#pagos.view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Ingresos
              h2 Registro de pagos
            button.btn.btn-primary#nuevoPago(type="button") + Registrar entrada
          div.content-card.table-card
            div.table-responsive
              table.table.align-middle.mb-0
                thead
                  tr
                    th Cliente
                    th Plan
                    th Monto
                    th Fecha y hora
                    th.admin-only Acción
                tbody#tablaPagos
          p#sinPagos.empty-copy.mt-3(hidden) Aún no hay pagos registrados.

        section#planes.view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Configuración
              h2 Planes
            button.btn.btn-primary#nuevoPlan(type="button") + Agregar plan
          div#listaPlanes.plan-grid
          p#sinPlanes.empty-copy(hidden) Aún no hay planes configurados.

        section#historial.view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Auditoría
              h2 Historial de movimientos
          div.content-card
            p.card-description Entradas, registros, pagos y modificaciones en orden cronológico.
            ul#listaHistorial.timeline
            p#sinHistorial.empty-copy(hidden) No hay movimientos registrados todavía.

        section#agenda.view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Organización
              h2 Agenda de citas
            div.calendar-controls
              button.btn-action#mesAnterior(type="button") ← Anterior
              strong#tituloMesAgenda
              button.btn-action#mesSiguiente(type="button") Siguiente →
          div.row.g-4
            div.col-lg-8
              div.content-card
                div.calendar-weekdays
                  span Dom
                  span Lun
                  span Mar
                  span Mié
                  span Jue
                  span Vie
                  span Sáb
                div#calendarioAgenda.calendar-grid
            div.col-lg-4
              div.content-card
                h3.h5 Publicar horario disponible
                p.card-description Los clientes solo podrán reservar los horarios publicados aquí.
                form#horarioDisponibleForm
                  label.form-label(for="tituloHorario") Nombre de la clase o cita
                  input.form-control#tituloHorario(type="text" value="Cita de Pilates" required)
                  label.form-label.mt-3(for="inicioHorario") Inicio
                  input.form-control#inicioHorario(type="datetime-local" required)
                  label.form-label.mt-3(for="finHorario") Fin
                  input.form-control#finHorario(type="datetime-local" required)
                  label.form-label.mt-3(for="cupoHorario") Cupo máximo
                  input.form-control#cupoHorario(type="number" min="1" value="1" required)
                  button.btn.btn-primary.w-100.mt-3(type="submit") Publicar horario
                hr.my-4
                h3.h5 Horarios publicados
                ul#listaHorariosPublicados.appointment-list
            div.col-lg-4
              div.content-card
                h3.h5#fechaAgendaSeleccionada Selecciona una fecha
                p.card-description Elige un día del calendario para agendar una cita.
                form#citaForm
                  input#fechaCita(type="hidden")
                  label.form-label(for="clienteCita") Cliente
                  select.form-select#clienteCita(required disabled)
                  div#contadorCitasCliente.appointment-balance Selecciona un cliente para ver sus clases y citas disponibles.
                  label.form-label.mt-3(for="horaCita") Horario
                  input.form-control#horaCita(type="time" required disabled)
                  button.btn.btn-primary.w-100.mt-3#guardarCita(type="submit" disabled) Agendar cita
                ul#listaCitasDia.appointment-list.mt-4

        section#ingresos.view-panel.admin-only(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Administración
              h2 Finanzas del negocio
          div.dashboard-grid.finance-metrics
            article.metric-card
              span.metric-label Ingresos del mes
              strong#ingresosMes $0.00
              small Pagos registrados este mes
            article.metric-card
              span.metric-label Ingresos totales
              strong#ingresosTotales $0.00
              small Histórico de cobros
            article.metric-card
              span.metric-label Ticket promedio
              strong#ticketPromedio $0.00
              small Por pago registrado
          div.row.g-4
            div.col-lg-8
              div.content-card.h-100
                h3.h5 Ingresos de los últimos 6 meses
                p.card-description Cobros registrados por mes
                div.chart-wrap.finance-chart#graficaIngresos
            div.col-lg-4
              div.content-card.h-100
                h3.h5 Ingresos por plan
                p.card-description Distribución acumulada
                ul#desglosePlanes.income-breakdown

      //- Modal de expediente
      div.modal.fade#clienteModal(tabindex="-1" aria-hidden="true")
        div.modal-dialog.modal-lg.modal-dialog-scrollable
          div.modal-content
            form#clienteForm
              div.modal-header
                div
                  p.eyebrow.mb-1 Expediente
                  h2.modal-title.fs-5#modalClienteTitulo Nuevo cliente
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
              div.modal-body
                input#clienteId(type="hidden")
                div.row.g-3
                  div.col-md-4
                    label.form-label(for="nombre") Nombre
                    input.form-control#nombre(type="text" required)
                  div.col-md-4
                    label.form-label(for="apellidoPaterno") Apellido paterno
                    input.form-control#apellidoPaterno(type="text" required)
                  div.col-md-4
                    label.form-label(for="apellidoMaterno") Apellido materno
                    input.form-control#apellidoMaterno(type="text" required)
                  div.col-md-6
                    label.form-label(for="contacto") Número de contacto
                    input.form-control#contacto(type="tel" required)
                  div.col-md-6
                    label.form-label(for="cumpleanos") Cumpleaños
                    input.form-control#cumpleanos(type="date" required)
                  div.col-12#datosAccesoCliente
                    p.eyebrow.mb-2 Acceso del cliente
                    div.row.g-3
                      div.col-md-6
                        label.form-label(for="emailCliente") Correo electrónico para iniciar sesión
                        input.form-control#emailCliente(type="email" autocomplete="email")
                      div.col-md-6
                        label.form-label(for="contrasenaTemporal") Contraseña temporal
                        input.form-control#contrasenaTemporal(type="password" minlength="8" autocomplete="new-password")
                    p.form-text El cliente podrá cambiar esta contraseña desde su perfil.
                  div.col-12
                    label.form-label(for="notas") Notas de salud o consideraciones
                    textarea.form-control#notas(rows="3" placeholder="Ej. lesión, enfermedad, limitación física o indicaciones importantes.")
              div.modal-footer
                button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-primary(type="submit") Guardar expediente

      div.modal.fade#pagoModal(tabindex="-1" aria-hidden="true")
        div.modal-dialog
          div.modal-content
            form#pagoForm
              div.modal-header
                h2.modal-title.fs-5 Registrar pago
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
              div.modal-body
                input#pagoClienteId(type="hidden")
                label.form-label(for="clientePago") Cliente que realizó el pago
                select.form-select#clientePago(required)
                label.form-label(for="fechaPago") Fecha de pago
                input.form-control#fechaPago(type="date" required)
                label.form-label.mt-3(for="montoPago") Monto (MXN)
                input.form-control#montoPago(type="number" min="0" step="0.01" placeholder="Selecciona un plan" readonly required)
                label.form-label.mt-3(for="planPago") Plan pagado
                select.form-select#planPago(required)
              div.modal-footer
                button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-primary(type="submit") Guardar pago

      div.modal.fade#planModal(tabindex="-1" aria-hidden="true")
        div.modal-dialog
          div.modal-content
            form#planForm
              div.modal-header
                h2.modal-title.fs-5#modalPlanTitulo Nuevo plan
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
              div.modal-body
                input#planId(type="hidden")
                label.form-label(for="planNombre") Nombre del plan
                input.form-control#planNombre(type="text" required)
                div.row.g-3.mt-1
                  div.col-md-6
                    label.form-label(for="planClases") Clases al mes
                    input.form-control#planClases(type="number" min="1" required)
                  div.col-md-6
                    label.form-label(for="planCosto") Costo mensual (MXN)
                    input.form-control#planCosto(type="number" min="0" step="0.01" required)
                label.form-label.mt-3(for="planVigencia") Vigencia en días
                input.form-control#planVigencia(type="number" min="1" value="30" required)
                p.form-text La fecha de caducidad se calculará desde la fecha del pago.
              div.modal-footer
                button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-primary(type="submit") Guardar plan

      div.modal.fade#eliminarPagoModal(tabindex="-1" aria-hidden="true")
        div.modal-dialog
          div.modal-content
            form#eliminarPagoForm
              div.modal-header
                h2.modal-title.fs-5 Confirmar eliminación de pago
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
              div.modal-body
                input#pagoEliminarId(type="hidden")
                p.mb-3 Esta acción eliminará el cargo del registro de pagos, las finanzas y el estado del cliente. También quedará registrada en el historial.
                label.form-label(for="contrasenaEliminarPago") Ingresa tu contraseña de administrador
                input.form-control#contrasenaEliminarPago(type="password" autocomplete="current-password" required)
                p#eliminarPagoError.form-error.mt-2(hidden) La contraseña no es correcta.
              div.modal-footer
                button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-danger(type="submit") Eliminar pago

    //- Portal móvil del cliente: solo se muestra a perfiles con rol cliente.
    div#clientAppView.app-shell(hidden)
      aside.sidebar
        div.sidebar-brand
          span.brand-mark
            img(src="/images/logo.jpg" alt="Logo de Estudio Pilates")
          span Estudio Pilates
        nav.sidebar-nav(aria-label="Navegación del cliente")
          button.client-nav-link.nav-link.active(type="button" data-client-view="clienteInicio") Inicio
          button.client-nav-link.nav-link(type="button" data-client-view="clientePagos") Pagos
          button.client-nav-link.nav-link(type="button" data-client-view="clienteHistorial") Historial
          button.client-nav-link.nav-link(type="button" data-client-view="clienteAgenda") Agenda
          button.client-nav-link.nav-link(type="button" data-client-view="clientePerfil") Perfil
        div.sidebar-bottom
          span#clienteActivo Cliente
          button#cerrarSesionCliente.btn-link(type="button") Cerrar sesión
      main.app-main
        header.app-header
          div
            p.eyebrow.mb-1 Mi estudio
            h1#clientPageTitle Inicio
          button.btn.btn-outline-primary.btn-sm#actualizarPortal(type="button") ↻ Actualizar
        section#clienteInicio.client-view-panel
          section.hero
            div
              p.eyebrow.mb-2 Mi membresía
              h2#clienteSaludo Bienvenida
              p.mb-0#clienteVigencia Cargando datos de tu suscripción…
            img.hero-silhouette(src="/images/logo.jpg" alt="Logo de Estudio Pilates")
          div.dashboard-grid
            article.metric-card
              span.metric-label Días de suscripción
              strong#clienteDiasRestantes 0
              small Hasta la fecha de vencimiento
            article.metric-card
              span.metric-label Clases disponibles
              strong#clienteClasesRestantes 0
              small Para asistir o agendar
            article.metric-card
              span.metric-label Citas disponibles
              strong#clienteCitasRestantes 0
              small Considerando citas futuras
          div.content-card
            h3.h5 Próxima clase
            p#proximaCitaCliente.card-description No tienes una cita programada.
        section#clientePagos.client-view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Mi cuenta
              h2 Mis pagos
          div.content-card.table-card
            div.table-responsive
              table.table.align-middle.mb-0
                thead
                  tr
                    th Plan
                    th Monto
                    th Fecha
                tbody#tablaPagosCliente
        section#clienteHistorial.client-view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Mi cuenta
              h2 Historial
          div.content-card
            p.card-description Solo se muestran los pagos asociados a tu cuenta.
            ul#historialCliente.timeline
        section#clienteAgenda.client-view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Mis reservas
              h2 Agenda
          div.content-card
            form#agendarCitaClienteForm
              label.form-label(for="horarioDisponibleCliente") Horarios disponibles
              select.form-select#horarioDisponibleCliente(required)
                option(value="") Cargando horarios disponibles…
              p#detalleHorarioCliente.form-text Selecciona un horario publicado por el estudio.
              button.btn.btn-primary.mt-3(type="submit") Reservar horario
            hr.my-4
            p.card-description Próximas citas agendadas.
            ul#agendaCliente.appointment-list
        section#clientePerfil.client-view-panel(hidden)
          div.section-heading
            div
              p.eyebrow.mb-1 Mi cuenta
              h2 Perfil
          div.content-card
            form#perfilClienteForm
              label.form-label(for="perfilCorreo") Correo electrónico
              input.form-control#perfilCorreo(type="email" autocomplete="email" required)
              label.form-label.mt-3(for="perfilTelefono") Número de teléfono
              input.form-control#perfilTelefono(type="tel" required)
              button.btn.btn-primary.mt-3(type="submit") Guardar datos
            hr.my-4
            form#passwordClienteForm
              label.form-label(for="nuevaPasswordCliente") Nueva contraseña
              input.form-control#nuevaPasswordCliente(type="password" minlength="8" autocomplete="new-password" required)
              button.btn.btn-outline-primary.mt-3(type="submit") Cambiar contraseña
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2")
    script(src="/css/js/supabase-config.js")
    script(src="/css/js/app.js" defer)
